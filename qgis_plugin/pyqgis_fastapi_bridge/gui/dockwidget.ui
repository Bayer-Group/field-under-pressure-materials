    <item>
     <widget class="QGroupBox" name="grpSession">
      <property name="title">
       <string>Sign in</string>
      </property>
      <layout class="QVBoxLayout" name="sessionLayout">
       <item>
        <widget class="QPushButton" name="btnSandbox">
         <property name="text">
          <string>Start sandbox (farmer, mock farm)</string>
         </property>
         <property name="toolTip">
          <string>POST /sandbox {"mode": "mock"}: no password, a token for 8 hours with a copy of a ready farm. Farmer role: own crop areas only, no grid.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="txtLogin">
         <property name="toolTip">
          <string>Account for POST /login. The analyst role sees all crop areas and the voivodeship grid.</string>
         </property>
         <property name="placeholderText">
          <string>Login (analyst)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="txtPassword">
         <property name="toolTip">
          <string>Sent only to POST /login and cleared right after; never saved.</string>
         </property>
         <property name="placeholderText">
          <string>Password</string>
         </property>
         <property name="echoMode">
          <enum>QLineEdit::Password</enum>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnLogin">
         <property name="text">
          <string>Log in</string>
         </property>
         <property name="toolTip">
          <string>POST /login {login, password}; the returned token is put in the token field.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="txtToken">
         <property name="toolTip">
          <string>Sent as Authorization: Bearer. Filled by the sandbox or the login; kept only while QGIS runs.</string>
         </property>
         <property name="placeholderText">
          <string>Access token (Bearer)</string>
         </property>
         <property name="echoMode">
