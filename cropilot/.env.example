# Copy to .env and adjust. .env is gitignored; never commit real keys.
# Both Django and docker compose read this file.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
# Local work only: without it DEBUG is off (no debug pages when the app is reachable from the network).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (docker compose service "db") ---
POSTGRES_DB=fieldpressure
POSTGRES_USER=fieldpressure
POSTGRES_PASSWORD=fieldpressure
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Data ---
# Folder with the downloaded hackathon datasets (weather, soil, cropland). Keep it outside git.
DATA_DIR=../field-under-pressure-data

# --- Assistant (Ola) ---
# LLM keys (below) are needed for the chat only: without them the map, the risks and their explanations work,
# and the chat is greyed out (GET /api/health/ -> assistant.available = false). Check them: python manage.py llm_models
# Guide search (RAG): vector store = docker compose service "qdrant".
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_COLLECTION=guides_mmlw_v1      # another name gives a separate guide index (e.g. a test clone)
# LLM: OpenAI-compatible endpoints, tried in this order (fallback on 429/5xx/timeout).
LLM_PROVIDERS=gemini,groq
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=                           # pick one from: python manage.py llm_models
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI: add it to LLM_PROVIDERS (e.g. openai,groq); the base URL defaults to https://api.openai.com/v1.
# OPENAI_API_KEY=
# OPENAI_MODEL=                         # pick one from: python manage.py llm_models
LLM_MAX_TOKENS_OUT=1500
LLM_INPUT_BUDGET=5000
# LLM_TIMEOUT_S=25                      # per call; a longer Retry-After than 3 s moves on to the next provider
ASSISTANT_ENABLE_SQL=0                  # needs a read-only DB role first (assistant/INTERFACE_PROPOSALS.md)
ASSISTANT_AGENT_MODE=0
# ASSISTANT_LLM=fake                    # chat endpoint answers with a fake model (frontend work without keys)
# Optional overrides (defaults shown):
# METODYKI_DIR=field-under-pressure-materials/metodyki   # guide PDFs + ryzyka_zebrane.xlsx
# RAG_DATA_DIR=assistant/data                           # generated index files (gitignored)
