# Application-wide configuration template. Copy it to .env in the repo root (.env is in .gitignore).
#
# Database connection settings used by docker compose, the backend (FastAPI) and the data loader:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d postgis
#
# The defaults are for local development only. On a shared server SET YOUR OWN PASSWORD
# and do not expose the database port to the internet (SSH tunnel / VPN).

POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spatial_db
POSTGRES_PORT=5432
