# Wzór konfiguracji całej aplikacji. Skopiuj do .env w rootcie repo (.env jest w .gitignore).
#
# Parametry połączenia z bazą PostGIS używane przez docker compose, backend (FastAPI) i loader danych:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d postgis
#
# Domyślne wartości działają tylko lokalnie (dev). Na współdzielonym serwerze USTAW WŁASNE HASŁO
# i nie wystawiaj portu bazy do internetu (tunel SSH / VPN).

POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spatial_db
POSTGRES_PORT=5432
